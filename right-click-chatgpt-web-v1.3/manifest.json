{
  "manifest_version": 3,
  "name": "Right Click → ChatGPT Web + Telegram",
  "version": "1.3.0",
  "description": "Bôi đen văn bản để hỏi ChatGPT Web; gửi câu trả lời cuối của ChatGPT sang Telegram bằng một nút bấm. Không cần OpenAI API key.",
  "permissions": ["storage", "tabs", "scripting", "contextMenus"],
  "host_permissions": ["<all_urls>", "https://api.telegram.org/*"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "exclude_matches": ["https://chatgpt.com/*"],
      "js": ["selection.js"],
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": ["https://chatgpt.com/*"],
      "js": ["chatgpt.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "ChatGPT Web + Telegram"
  }
}
