{
  "manifest_version": 3,
  "name": "Right Click → ChatGPT Web",
  "version": "1.9.0",
  "description": "Bôi đen văn bản, chuột phải và gửi trực tiếp sang ChatGPT Web.",
  "permissions": ["tabs", "scripting", "contextMenus"],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://chat.openai.com/*"
  ],
  "background": {
    "service_worker": "background-direct-v2.js"
  },
  "content_scripts": [
    {
      "matches": ["https://chatgpt.com/*", "https://chat.openai.com/*"],
      "js": ["chatgpt-direct.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Right Click → ChatGPT"
  }
}
