{
  "manifest_version": 3,
  "name": "Right Click → ChatGPT Web",
  "version": "2.5.0",
  "description": "Chuột phải gửi văn bản sang ChatGPT Web; Alt + chuột phải hỏi Gemini và gửi câu trả lời qua Telegram hoặc Zalo OA; đọc màn hình Android bằng ADB/OCR.",
  "permissions": ["tabs", "scripting", "storage"],
  "host_permissions": [
    "<all_urls>",
    "http://127.0.0.1:8765/*",
    "https://generativelanguage.googleapis.com/*",
    "https://api.telegram.org/*",
    "https://openapi.zalo.me/*"
  ],
  "options_page": "options.html",
  "background": {
    "service_worker": "background-direct-v2.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["floating-button.js"],
      "run_at": "document_start",
      "all_frames": false
    },
    {
      "matches": ["<all_urls>"],
      "exclude_matches": ["https://chatgpt.com/*", "https://chat.openai.com/*"],
      "js": ["selection.js"],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true,
      "match_origin_as_fallback": true
    },
    {
      "matches": ["https://chatgpt.com/*", "https://chat.openai.com/*"],
      "js": ["chatgpt-direct.js"],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_title": "Đọc màn hình điện thoại → ChatGPT"
  }
}
