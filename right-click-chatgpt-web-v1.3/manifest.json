{
  "manifest_version": 3,
  "name": "Right Click → ChatGPT Web",
  "version": "2.1.0",
  "description": "Bôi đen rồi chuột phải để tự gửi sang ChatGPT Web, hoặc đọc text màn hình Android qua ADB.",
  "permissions": ["tabs", "scripting"],
  "host_permissions": [
    "<all_urls>",
    "http://127.0.0.1:8765/*"
  ],
  "background": {
    "service_worker": "background-direct-v2.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "exclude_matches": ["https://chatgpt.com/*", "https://chat.openai.com/*"],
      "js": ["selection.js"],
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": ["https://chatgpt.com/*", "https://chat.openai.com/*"],
      "js": ["chatgpt-direct.js"],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Right Click → ChatGPT"
  }
}
